    {
      "parameters": {
        "jsCode": "const pages=$input.all().map(i=>i.json),account=$('Validate Crunchyroll account').first().json.account_id,path='/content/v1/watch-history/'+account,events=[],ids=new Set(),seenLinks=new Set();\nif(pages.length<2||pages.length>20)throw Error('Invalid history page count');\npages.forEach((p,i)=>{if(!Array.isArray(p.items)||p.items.length>20)throw Error('History page changed shape');\nfor(const e of p.items){if(!e||typeof e.id!=='string'||!e.id||ids.has(e.id)||typeof e.date_played!=='string'||!/^\\d{4}-\\d\\d-\\d\\dT/.test(e.date_played)||!Number.isFinite(Date.parse(e.date_played))||typeof e.fully_watched!=='boolean')throw Error('History event changed shape or repeats');ids.add(e.id);events.push(e)}\nif(p.next_page){if(typeof p.next_page!=='string'||(!p.next_page.startsWith(path+'?')&&!p.next_page.startsWith('?'))||p.next_page.includes('#')||seenLinks.has(p.next_page))throw Error('Invalid pagination link');seenLinks.add(p.next_page)}\nelse if(i!==pages.length-1)throw Error('History ended before final page')});\nif(events.length<40||events.length>400)throw Error('History outside 40-400 event bounds');\nreturn [{json:{p_account_id:account,p_events:events,p_execution_id:'n8n:'+$execution.id}}];"
      },
