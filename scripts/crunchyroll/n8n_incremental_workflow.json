              "nextURL": "={{ (() => { const next=$response.body.next_page; const path='/content/v1/watch-history/'+$('Validate Crunchyroll account').first().json.account_id; if(typeof next!=='string'||(!next.startsWith(path+'?')&&!next.startsWith('?'))||next.includes('#')) throw Error('Unexpected Crunchyroll pagination link'); return 'https://www.crunchyroll.com'+(next.startsWith('?')?path+next:next); })() }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.next_page || $pageCount >= 19 }}",
